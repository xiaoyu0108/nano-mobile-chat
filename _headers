# Netlify 缓存策略（放在站点根目录，Netlify 会自动读取）
# 目标：HTML/JS/CSS 永远拿到最新，图片图标长缓存 → 配合 sw.js 让第二次打开秒开

/*.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# 版本化资源（?v=）可以安全复用；未带版本号的脚本交给 SW 后台更新。
# 不再对全部 JS/CSS 强制 no-cache，否则每次打开都要重新回源，页面会明显变慢。
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=3600
