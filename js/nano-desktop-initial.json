ke-linejoin=\"round\"><rect x=\"3.5\" y=\"4.5\" width=\"17\" height=\"15\" rx=\"3\"/><circle cx=\"9\" cy=\"10\" r=\"1.6\"/><path d=\"M4 17l5-4.5 4 3.5 3-2.5 4.5 3.5\"/></svg><img alt=\"\"></div>\n  <div class=\"cap\"><span contenteditable=\"true\" spellcheck=\"false\" data-t=\"cap\">我们的冬天 未完待续</span></div>\n</div>\n<input id=\"pick\" type=\"file\" accept=\"image/*\" hidden>\n<script>\n// 点灰色图片位选图，自动保存；点文字直接修改\nvar W=window.__nanoWidgetId||'',imgs=window.__nanoWidgetImages||{},pick=document.getElementById('pick'),cur='';\nfunction setImg(k,src){document.querySelectorAll('.slot[data-k=\"'+k+'\"]').forEach(function(b){b.querySelector('img').src=src;b.classList.add('has')})}\nObject.keys(imgs).forEach(function(k){if(imgs[k])setImg(k,imgs[k])});\ndocument.querySelectorAll('.slot').forEach(function(el){el.onclick=function(){cur=el.getAttribute('data-k');pick.value='';pick.click()}});\npick.onchange=function(){var f=pick.files&&pick.files[0];if(!f||!cur)return;var K=cur,r=new FileReader();\n r.onload=function(){var im=new Image();im.onload=function(){var max=900,s=Math.min(1,max/Math.max(im.width,im.height));\n  var c=document.createElement('canvas');c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);\n  c.getContext('2d').drawImage(im,0,0,c.width,c.height);var d=c.toDataURL('image/jpeg',.86);\n  setImg(K,d);parent.postMessage({type:'nanoWidgetImage',widget:W,key:K,data:d},'*')};im.src=r.result};r.readAsDataURL(f)};\nvar SK='nanoTxt_'+W,saved={};try{saved=JSON.parse(localStorage.getItem(SK)||'{}')}catch(e){}\ndocument.querySelectorAll('[data-t]').forEach(function(el){var k=el.getAttribute('data-t');\n if(saved[k]!=null)el.textContent=saved[k];\n el.addEventListener('input',function(){saved[k]=el.textContent;try{localStorage.setItem(SK,JSON.stringify(saved))}catch(e){}});\n el.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();el.blur()}})});\n\n</script>\n","live":true},"w":4,"h":2,"o":0.6,"lib":null},{"id":"wmwxlu1zc3gy","t":"bt0","c":0,"r":5,"d":{"code":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>灰粉对话框小组件</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent;font-family:-apple-system,\"PingFang SC\",\"Apple SD Gothic Neo\",sans-serif}\n.card{\n  height:100%;\n  border-radius:22px;\n  background:transparent;\n  padding:8px 14px;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  position:relative;\n}\n.bubbles{\n  position:relative;\n  width:100%;\n  max-width:320px;\n  display:flex;\n  flex-direction:column;\n  align-items:flex-start;\n}\n.bubble{\n  position:relative;\n  border-radius:16px;\n  padding:7px 12px;\n  font-size:12px;\n  line-height:1.28;\n  font-weight:500;\n  word-break:keep-all;\n  outline:none;\n  cursor:text;\n}\n.bubble:focus{\n  box-shadow:0 0 0 2px rgba(0,0,0,.08);\n}\n.bubble.dark{\n  background:#4a4a4a;\n  color:#fff;\n  background-image:radial-gradient(circle, #f8b6c8 1.5px, transparent 1.5px);\n  background-size:13px 13px;\n  background-position:3px 3px;\n  z-index:2;\n  margin-bottom:-6px;\n  align-self:flex-start;\n  max-width:92%;\n}\n/* 深灰尾巴 - 三角形，往上多叠一点消除空隙 */\n.bubble.dark::after{\n  content:\"\";\n  position:absolute;\n  left:14px;\n  bottom:-8px;\n  width:0;\n  height:0;\n  border-style:solid;\n  border-width:10px 9px 0 0;\n  border-color:#4a4a4a transparent transparent transparent;\n  transform:rotate(12deg);\n}\n.bubble.pink{\n  background:#f9d5e0;\n  color:#5a5a5a;\n  z-index:1;\n  margin-top:2px;\n  align-self:flex-end;\n  max-width:88%;\n  padding:7px 12px;\n}\n/* 浅粉尾巴 */\n.bubble.pink::after{\n  content:\"\";\n  position:absolute;\n  right:16px;\n  bottom:-8px;\n  width:0;\n  height:0;\n  border-style:solid;\n  border-width:10px 0 0 9px;\n  border-color:#f9d5e0 transparent transparent transparent;\n  transform:rotate(-12deg);\n}\n.star{font-size:13px;opacity:.95}\n.dots{letter-spacing:1px}\n</style>\n</head>\n<body>\n<div class=\"card\">\n  <div class=\"bubbles\">\n    <div class=\"bubble dark\" contenteditable=\"true\" spellcheck=\"false\"><span class=\"star\">☆</span></div>\n    <div class=\"bubble pink\" contenteditable=\"true\" spellcheck=\"false\"><span class=\"dots\">ππ</span></div>\n  </div>\n</div>\n<script>\n(function(){\n  var W = window.__nanoWidgetId || '';\n  var SK = 'nanoTxt_' + W;\n  var saved = {};\n  try { saved = JSON.parse(localStorage.getItem(SK) || '{}') || {}; } catch (e) {}\n  var els = document.querySelectorAll('[contenteditable=\"true\"]');\n  els.forEach(function(el, i){\n    var k = 't' + i;\n    if (typeof saved[k] === 'string' && saved[k] !== '') el.innerHTML = saved[k];\n    el.addEventListener('input', function(){\n      saved[k] = el.innerHTML;\n      try { localStorage.setItem(SK, JSON.stringify(saved)); } catch (e) {}\n    });\n  });\n})();\n</script>\n</body>\n</html>\n","live":true},"w":4,"h":1,"lib":null}]]},"imgs":{}}